<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DemoTape.App.UI.FeatureCardsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Quick tips" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="A few things DemoTape can do that you might have missed."
                       Opacity="0.65" FontSize="12" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Card pager: FlipView cycles through cards -->
        <FlipView x:Name="CardFlipView" Grid.Row="1" MinHeight="200">
            <FlipView.ItemTemplate>
                <DataTemplate>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="12" Padding="28,24">
                        <StackPanel Spacing="12" VerticalAlignment="Center">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="{Binding Icon}"
                                      FontSize="36" HorizontalAlignment="Center"
                                      Foreground="#22B0E6" />
                            <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold"
                                       TextAlignment="Center" />
                            <TextBlock Text="{Binding Body}" FontSize="13" Opacity="0.8"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       MaxWidth="360" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </FlipView.ItemTemplate>
        </FlipView>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12"
                    HorizontalAlignment="Right" Margin="0,20,0,0">
            <ToggleSwitch x:Name="DontShowToggle" Header="Don't show again"
                          OffContent="" OnContent="" Margin="0,0,8,0" />
            <Button x:Name="GotItButton" Content="Got it" Click="OnGotIt"
                    Background="#22B0E6" Foreground="White" Padding="20,8" />
        </StackPanel>
    </Grid>
</Window>
