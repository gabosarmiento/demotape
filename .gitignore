# Swift Package Manager build output
.build/
Package.resolved

# Packaged app bundle (produced by build-app.sh)
*.app/

# Distributable disk images (produced by make-dmg.sh)
dist/
*.dmg

# Signing artifacts
*.p12
*.pem

# macOS
.DS_Store

# Editor
.vscode/
*.xcuserstate
xcuserdata/

# Local recordings / exports (should never be committed)
*.mov
*.mp4
*.events.json
# ...except curated README/demo assets, which live in media/ on purpose
!media/*.mp4

# Local verification scratch dir (live API probes, secrets via env — never commit)
.verify/

# Playwright demo driver (external Node tool — deps not committed)
tools/demo-driver/node_modules/
tools/demo-driver/driver.log

# Locally installed copy of the record-verified-demo skill (created by
# tools/demo-driver/skill/install.sh --kiro). The source of truth is that folder,
# so committing the copy would just create a second one that drifts.
.kiro/

# Browser profiles used to record demos of authenticated apps. Signing in once leaves a
# live session here, so these hold real credentials/cookies — never commit them.
tools/demo-driver/.profiles/

# Someone's own demo configs and probes. These name real hosts, tenants, routes, selectors and page
# copy from the app being demoed — that's the author's product, not this tool's business, and this
# repo is public. Keep them here; demo.example.json is the reference to copy.
tools/demo-driver/.local/
tools/demo-driver/demo-*.local.json

# Python bytecode from the local TTS shim
__pycache__/
*.pyc

# Scratch files used to compose commit/PR bodies (heredocs hang the shell, so these are written
# to disk first and deleted after).
.git-commit-msg.tmp
.gh-notes.tmp

# graphify code-graph output + caches (generated; not part of the app)
graphify-out/
Sources/graphify-out/
.graphify_*.json
.graphify_*.txt
